# Copy this file to .env and fill in DB_USER / DB_PASSWORD (from Canvas).
# .env is in .gitignore, so your password never goes to GitHub.
DB_SERVER=is-info430.ischool.uw.edu
DB_PORT=1433
DB_USER=
DB_PASSWORD=
# Your own database: <your NetID>_myapp
DB_NAME=wjford_myapp
# Port uvicorn listens on
PORT=8000
